[credential]
	helper = !gh auth git-credential

[fetch]
	prune = true

[push]
	autoSetupRemote = true

[init]
	defaultBranch = main

[rerere]
	enabled = true

[merge]
	conflictstyle = zdiff3

[pull]
	rebase = true

[diff]
	algorithm = histogram
	colorMoved = default

[commit]
	verbose = true

[help]
	autocorrect = prompt

[log]
	date = iso
	abbrevCommit = true
	decorate = short

[status]
	showUntrackedFiles = all

[core]
	untrackedCache = true
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	side-by-side = true

[alias]
	st = status
	br = branch
	last = lg -1
	unstage = restore --staged
	lg = log --graph --abbrev-commit --decorate --pretty=format:'%C(yellow)%h%Creset -%C(red)%d%Creset %s %C(green)(%cr) %C(bold blue)<%an>%Creset'

[include]
	path = ~/.config/git/config.local


[branch]
	sort = -committerdate
